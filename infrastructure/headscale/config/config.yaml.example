server_url: http://82.70.74.120:8085
listen_addr: 0.0.0.0:8080
metrics_listen_addr: 0.0.0.0:9090

db_type: sqlite3
db_path: /var/lib/headscale/db.sqlite

acl_policy_mode: file
acl_policy_path: /etc/headscale/acl.hujson

derp:
  server_url: https://controlplane.tailscale.com/derpmap/default
  urls:
    - https://controlplane.tailscale.com/derpmap/default
  auto_update_enabled: true
  paths:
    - /var/lib/headscale/derpmap.json

tls_letsencrypt: false
tls_cert_path: ""
tls_key_path: ""

log:
  format: text
  level: info

policy:
  mode: file
  path: /etc/headscale/acl.hujson

ephemeral_node_inactivity_timeout: 30m

name:
  allow_rename: true

namespace:
  allow_create: true

ip_prefixes:
  - 100.64.0.0/10
  - fd7a:115c:a1e0::/48
